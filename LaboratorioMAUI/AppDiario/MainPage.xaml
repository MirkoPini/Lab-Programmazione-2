<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppDiario.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="50">
            
            <Label x:Name="lblDiario" 
                   Text="IL mio diario"
                   FontSize="24"
                   FontAttributes="Bold"/>
            
            <Entry x:Name="EntTitolo"
                   Placeholder="Inserisci Titolo"/>
            
            <Entry x:Name="EntTesto"
                   Placeholder="Inserisci Testo"/>
            
            <Button x:Name="btnSalva"
                    Text="Salva Nota"
                    Clicked="OnSalvaClicked"
                    BackgroundColor="Green"/>
            
            <Button x:Name="btnLeggi"
                    Text="Leggi tutte le note"
                    Clicked="OnLeggiClicked"/>

            <Label x:Name="lblNoteSalvate"
                   Text="Note salvate nel file:" 
                   FontAttributes="Italic"/>

            <Editor x:Name="EdiDisplay"
                    HeightRequest="300"
                    IsReadOnly="True"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
    
