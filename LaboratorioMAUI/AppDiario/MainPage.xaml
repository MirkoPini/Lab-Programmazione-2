<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppDiario.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" HorizontalOptions="Center">
            <Label 
                Text="IL mio diario"
                FontSize="24" 
                FontAttributes="Bold" />
            
            <Entry x:Name="EntTitolo"
                   Placeholder="Inserisci Titolo" />
            
            <Entry x:Name="EntTesto"
                   Placeholder="Inserisci Testo" />
            
            <Button Text="SALVA NOTA"
                    Clicked="OnSalvaClicked"
                    BackgroundColor="Green" />
            
            <Button Text="LEGGI TUTTE LE NOTE"
                    Clicked="OnLeggiClicked" />
            
            <Editor x:Name="EdiDisplay"
                    HeightRequest="300"
                    IsReadOnly="True" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
    
