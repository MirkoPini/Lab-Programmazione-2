<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppSpese.DettaglioPage"
             Title="DettaglioPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Label x:Name="lblTitolo"
                   Text="DETTAGLIO SPESE"
                   FontSize="30"
                   HorizontalOptions="Center"/>

            <Label x:Name="lblPath"
                   Text="nome"
                   HorizontalOptions="Center"
                   FontSize="20"/>

            <Editor x:Name="EdiListe"
                    HeightRequest="300" 
                    IsReadOnly="True" />

            <Button x:Name="btnIndietro"
                    Text="TORNA INDIETRO"
                    Clicked="OnIndietroClicked"
                    BackgroundColor="Gray"
                    TextColor="White"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>