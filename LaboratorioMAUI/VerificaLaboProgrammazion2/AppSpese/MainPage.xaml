<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppSpese.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Label x:Name="lblTitolo"
                   Text="LE MIE SPESE"
                   FontSize="30"
                   HorizontalOptions="Center"/>

            <Entry x:Name="EntNomeLista"
                   Placeholder="Nome lista(es: marzo)"/>

            <Entry x:Name="EntDescrizione"
                   Placeholder="Descrizione spesa"/>

            <Entry x:Name="EntImporto"
                   Placeholder="Importo"/>

            <Button x:Name="btnSalva"
                    Text="SALVA SPESA"
                    Clicked="OnSalvaClicked"
                    BackgroundColor="Green"
                    TextColor="White"/>

            <Button x:Name="btnVedi"
                    Text="VEDI SPESE"
                    Clicked="OnVediCliCked"
                    BackgroundColor="BLUE"
                    TextColor="White"/>

            <Label x:Name="lblListe"
                   Text="Liste Salvate:"
                   FontFamily=""/>

            <Editor x:Name="EdiListe"
                    HeightRequest="200" 
                    IsReadOnly="True" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
