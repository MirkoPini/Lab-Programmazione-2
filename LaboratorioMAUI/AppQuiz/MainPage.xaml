<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppQuiz.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">
            <Label x:Name="ScoreLabel"
                   Text="Punti: 0"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}"/>
            <VerticalStackLayout Spacing="15">
                <Label Text="DOMANDA"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>

                <Label x:Name="QuestionTextLabel"
                       Text="Caricamento domanda..."
                       FontSize="24"
                       HorizontalOptions="Center"
                       FontAttributes="Bold"
                       TextColor="White"/>

                <Image x:Name="ImgQst"
                       Source="dotnet_bot.png"
                       HeightRequest="185"
                       Aspect="AspectFit"
                       SemanticProperties.Description="ImgQst"/>

            </VerticalStackLayout>
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <Button x:Name="TrueButton"
                        Text="VERO"
                        Clicked="OnAnswerClicked"
                        CommandParameter="true"
                        WidthRequest="130"
                        HeightRequest="60"
                        FontSize="18"
                        BackgroundColor="#27ae60"
                        CornerRadius="10"/>
                
                <Button x:Name="FalseButton"
                        Text="FALSO"
                        Clicked="OnAnswerClicked"
                        CommandParameter="false"
                        WidthRequest="130"
                        HeightRequest="60"
                        FontSize="18"
                        BackgroundColor="#c0392b"
                        CornerRadius="10"/>
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="Auto, * , Auto">
                <Button Grid.Column="0"
                        x:Name="ResetButton"
                        Text="Reset"
                        Clicked="OnResetClicked"
                        WidthRequest="130"
                        HeightRequest="60"
                        FontSize="18"
                        CornerRadius="10"/>

                <Button Grid.Column="2"
                        x:Name="HintButton"
                        Clicked="OnHintClicked"
                        Text="Aiuto"
                        WidthRequest="130"
                        HeightRequest="60"
                        FontSize="18"
                        CornerRadius="10"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
