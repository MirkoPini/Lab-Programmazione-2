<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppQuiz.ResultPage"
             Title="ResultPage">
    <VerticalStackLayout VerticalOptions="Center" Spacing="20" Padding="50">
        <Label x:Name="lblStatus"
               Text="QUIZ COMPLETATO!"
               FontSize="50"
               HorizontalOptions="Center"/>

        <Border Background="{AppThemeBinding Light={StaticResource #d1d1d1}, Dark={StaticResource #3b3c3d}}" 
                StrokeShape="RoundRectangle 10" 
                HeightRequest="150" 
                HorizontalOptions="FillAndExpand">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <Label
                x:Name="lblPunteggio"
               Text="Il tuo punteggio"
               HorizontalOptions="Center"/>

                <Label
                x:Name="lblScore" 
                Text="0"
                TextColor="#512BD4"
                FontSize="50"
                HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

        <Label x:Name="lblBestScore"
               Text="🏆 Miglior Punteggio: 0"
               TextColor="Gold"
               HorizontalOptions="Center"/>
        
        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
            
            <Entry x:Name="EntName"
                   WidthRequest="200"
                   Placeholder="Inserisci il tuo nome"
                   Keyboard="Text"
                   HorizontalOptions="Center"/>

            <Button x:Name="BtnSave"
                    WidthRequest="100"
                    Text="Salva"
                    Clicked="OnSaveClicked"/>

        </HorizontalStackLayout>

        <Button x:Name="btnPlayAgain"
                Text="GIOCA ANCORA"
                CornerRadius="20"
                Clicked="OnPlayAgainClicked"/>
    </VerticalStackLayout>
</ContentPage>