<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppAgenda.Valutazioni"
             Title="">
    <VerticalStackLayout
        Spacing="20"
        Padding="30">
        <Grid ColumnDefinitions="*, *">
            <Label 
                Text="Valutazioni"
                FontSize="50"
                Grid.Column="0"
                HorizontalOptions="Start"/>
            <ImageButton
                Source="whitestats.png"
                Grid.Column="1"
                HorizontalOptions="End"
                WidthRequest="40"
                HeightRequest="40"
                BackgroundColor="Transparent"
                />
        </Grid>
        <Grid ColumnDefinitions="*, *, *"
              ColumnSpacing="20">
            <Frame
                Grid.Column="0"
                HorizontalOptions="Fill"
                BackgroundColor="#555555">
                <Grid
                    RowDefinitions="*, *"
                    ColumnDefinitions="*, *, auto"
                    RowSpacing="10">
                    
                    <Label
                        Text="Materia"
                        FontSize="30"
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="Center"/>
                    <Label
                        Text="N1 | N2 | N3"
                        FontSize="15"
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalOptions="Center"/>
                    <Label
                        Text="5.0"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="20"
                        />
                    <ImageButton 
                        Source="arrow.png"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        WidthRequest="10"
                        HeightRequest="10"
                        Aspect="AspectFit"
                        HorizontalOptions="End"
                        BackgroundColor="Transparent"
                        Clicked="ImageButton_Clicked"
                     />
                    
                </Grid>
                
            </Frame>
            <Frame
                Grid.Column="1"
                HorizontalOptions="Fill"
                BackgroundColor="#555555">
                <Grid
                    RowDefinitions="*, *"
                    ColumnDefinitions="*, *, auto"
                    RowSpacing="10">

                    <Label
                        Text="Materia"
                        FontSize="30"
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="Center"/>
                    <Label
                        Text="N1 | N2 | N3"
                        FontSize="15"
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalOptions="Center"/>
                    <Label
                        Text="5.0"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="20"/>
                    <ImageButton 
                        Source="arrow.png"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        WidthRequest="10"
                        HeightRequest="10"
                        Aspect="AspectFit"
                        HorizontalOptions="End"
                        BackgroundColor="Transparent"
                        Clicked="ImageButton_Clicked"/>
                    </Grid>
            </Frame>
            <Frame
                Grid.Column="2"
                HorizontalOptions="Fill"
                BackgroundColor="#555555">
                <Grid
                    RowDefinitions="*, *"
                    ColumnDefinitions="*, *, auto"
                    RowSpacing="10">

                    <Label
                        Text="Materia"
                        FontSize="30"
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="Center"/>
                    <Label
                        Text="N1 | N2 | N3"
                        FontSize="15"
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalOptions="Center"/>
                    <Label
                        Text="5.0"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="20"/>
                    <ImageButton 
                        Source="arrow.png"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        WidthRequest="10"
                        HeightRequest="10"
                        Padding="0"
                        Aspect="AspectFit"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        BackgroundColor="Transparent"
                        Clicked="ImageButton_Clicked"/>
                </Grid>
            </Frame>
        </Grid>
        <CollectionView
    x:Name="CvMaterie"
    ItemsLayout="VerticalGrid, 3">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame
                Margin="10"
                BackgroundColor="#555555">

                        <Grid
                    RowDefinitions="*, *"
                    ColumnDefinitions="*, *, auto"
                    RowSpacing="10">

                            <Label
                        Text="{Binding Nome}"
                        FontSize="30"
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalOptions="Center"/>

                            <Label
                        Text="{Binding ElencoNote}"
                        FontSize="15"
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalOptions="Center"/>

                            <Label
                        Text="{Binding Media}"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontSize="20"/>

                            <ImageButton
                        Source="arrow.png"
                        Grid.Column="2"
                        Grid.RowSpan="2"
                        WidthRequest="10"
                        HeightRequest="10"
                        BackgroundColor="Transparent"
                        Clicked="ImageButton_Clicked"/>

                        </Grid>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <HorizontalStackLayout HorizontalOptions="End" Padding="50">
            <Button 
                x:Name="BtnAddSubject"
                Text="+"
                Clicked="BtnAddSubjectClicked"
                FontSize="30"
                WidthRequest="60"
                CornerRadius="50"
                BackgroundColor="White"
                TextColor="Black"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>