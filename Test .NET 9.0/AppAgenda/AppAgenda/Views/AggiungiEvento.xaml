<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             x:Class="AppAgenda.AggiungiEvento"
             Title="">
    <VerticalStackLayout Spacing="20" Padding="50">

        <Label x:Name="LblTitolo"
               Text="Aggiungi un evento!"
               FontSize="40"
               VerticalOptions="Center" 
               HorizontalOptions="Center"/>

        <Label x:Name="LblEntTitolo"
               Text="Inserisci il titolo:"/>

        <Entry x:Name="EntTitolo"
               Placeholder="Inserisci il titolo dell'evento..."
               MaxLength="35"/>

        <Label x:Name="LblEntDescrizione"
               Text="Inserisci la descrizione:"/>

        <Entry x:Name="EntDescrizione"
                Placeholder="Inserisci la descrizione dell'evento..."/>

        <Button x:Name="BtnSave"
                Text="SALVA"
                Clicked="BtnSaveClicked"/>

        
    </VerticalStackLayout>
</ContentPage>