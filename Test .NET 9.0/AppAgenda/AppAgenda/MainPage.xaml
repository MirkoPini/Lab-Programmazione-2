<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cal="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             x:Class="AppAgenda.MainPage"
             Title="">

    <ScrollView>
        <VerticalStackLayout>

            <Label x:Name="LblNome"
                   Text="Benvenuto"
                   FontSize="60"
                   Padding="50"/>

            <cal:Calendar x:Name="Calendario" 
                  Events="{Binding Events}" 
                  EventsScrollViewVisible="True" 
                  Padding="30"
                  FirstDayOfWeek="Monday"
                  OtherMonthDayColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray300}}"
                  DeselectedDayTextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                  SelectedDayTextColor="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"
                
                  WeekendTitleStyle="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"/>
            <HorizontalStackLayout Spacing="150" HorizontalOptions="Center">
                
                <Button x:Name="BtnEventoRecente1"
                        Text="Evento 1"
                        WidthRequest="300"
                        HeightRequest="100"
                        BackgroundColor="#0366fc"
                        FontSize="30"/>

                <Button x:Name="BtnEventoRecente2"
                        Text="Evento 2"
                        WidthRequest="300"
                        HeightRequest="100"
                        BackgroundColor="#0366fc"
                        FontSize="30"/>
                
                <Button x:Name="BtnEventoRecente3"
                        Text="Evento 3"
                        WidthRequest="300"
                        HeightRequest="100"
                        BackgroundColor="#0366fc"
                        FontSize="30"/>

                <Button x:Name="BtnEventoRecente4"
                        Text="Evento 4"
                        WidthRequest="300"
                        HeightRequest="100"
                        BackgroundColor="#0366fc"
                        FontSize="30"/>

            </HorizontalStackLayout>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
