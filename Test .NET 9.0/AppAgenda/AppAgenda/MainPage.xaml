<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cal="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             x:Class="AppAgenda.MainPage"
             Title=""
             BackgroundColor="{AppThemeBinding Light=#F4F6FB, Dark=#0F1117}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentBlue">#3B5BDB</Color>
            <Color x:Key="AccentGreen">#0CA678</Color>
            <Color x:Key="AccentOrange">#E8590C</Color>
            <Color x:Key="AccentPurple">#9C36B5</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ═══ HEADER ═══ -->
            <Border BackgroundColor="{AppThemeBinding Light=#3B5BDB, Dark=#1A2460}"
                    StrokeThickness="0"
                    Padding="24,48,24,28">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,28,28"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="LblDataOggi"
                           Text="Mercoledì, 27 Maggio 2026"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#AABFFF, Dark=#6680CC}"/>
                    <Label x:Name="LblNome"
                           Text="Benvenuto 👋"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=White, Dark=#C8D8FF}"/>
                </VerticalStackLayout>
            </Border>

            <!-- ═══ CALENDARIO ═══ -->
            <Border Margin="16,18,16,0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#161B27}"
                    Stroke="{AppThemeBinding Light=#E8EAF0, Dark=#252B3B}"
                    StrokeThickness="1"
                    Padding="4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <cal:Calendar x:Name="Calendario"
                      Events="{Binding Events}"
                      EventsScrollViewVisible="True"
                      Padding="12,12,12,4"
                      FirstDayOfWeek="Monday"
                      OtherMonthDayColor="{AppThemeBinding Light=#BBBBCC, Dark=#555566}"
                      DeselectedDayTextColor="{AppThemeBinding Light=#22223B, Dark=#E0E0F0}"
                      SelectedDayTextColor="{AppThemeBinding Light=White, Dark=White}"
                      SelectedDayBackgroundColor="{AppThemeBinding Light=#3B5BDB, Dark=#2A4AB8}"/>
            </Border>

            <!-- ═══ PROSSIMI EVENTI ═══ -->
            <VerticalStackLayout Spacing="8" Margin="16,22,16,32">

                <Label x:Name="LblProssimiEventi"
                       Text="PROSSIMI EVENTI"
                       FontSize="11"
                       FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{AppThemeBinding Light=#8888AA, Dark=#7777AA}"
                       Margin="2,0,0,4"/>

                <!-- Card Evento 1 -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B27}"
                        Stroke="{AppThemeBinding Light=#E8EAF0, Dark=#252B3B}"
                        StrokeThickness="1"
                        Padding="0"
                        MinimumHeightRequest="64">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="4,*,Auto">
                        <BoxView BackgroundColor="{AppThemeBinding Light=#3B5BDB, Dark=#2A4AB8}"
                                 Grid.Column="0"/>
                        <Button x:Name="BtnEventoRecente1"
                                Text="Evento 1"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#22223B, Dark=#E0E0F0}"
                                FontSize="15"
                                FontAttributes="Bold"
                                Grid.Column="1"/>
                        <Label Text="›"
                               FontSize="22"
                               TextColor="{AppThemeBinding Light=#BBBBCC, Dark=#444466}"
                               VerticalOptions="Center"
                               Margin="0,0,14,0"
                               Grid.Column="2"/>
                    </Grid>
                </Border>

                <!-- Card Evento 2 -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B27}"
                        Stroke="{AppThemeBinding Light=#E8EAF0, Dark=#252B3B}"
                        StrokeThickness="1"
                        Padding="0"
                        MinimumHeightRequest="64">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="4,*,Auto">
                        <BoxView BackgroundColor="{AppThemeBinding Light=#0CA678, Dark=#0A7A5A}"
                                 Grid.Column="0"/>
                        <Button x:Name="BtnEventoRecente2"
                                Text="Evento 2"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#22223B, Dark=#E0E0F0}"
                                FontSize="15"
                                FontAttributes="Bold"
                                Grid.Column="1"/>
                        <Label Text="›"
                               FontSize="22"
                               TextColor="{AppThemeBinding Light=#BBBBCC, Dark=#444466}"
                               VerticalOptions="Center"
                               Margin="0,0,14,0"
                               Grid.Column="2"/>
                    </Grid>
                </Border>

                <!-- Card Evento 3 -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B27}"
                        Stroke="{AppThemeBinding Light=#E8EAF0, Dark=#252B3B}"
                        StrokeThickness="1"
                        Padding="0"
                        MinimumHeightRequest="64">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="4,*,Auto">
                        <BoxView BackgroundColor="{AppThemeBinding Light=#E8590C, Dark=#B04008}"
                                 Grid.Column="0"/>
                        <Button x:Name="BtnEventoRecente3"
                                Text="Evento 3"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#22223B, Dark=#E0E0F0}"
                                FontSize="15"
                                FontAttributes="Bold"
                                Grid.Column="1"/>
                        <Label Text="›"
                               FontSize="22"
                               TextColor="{AppThemeBinding Light=#BBBBCC, Dark=#444466}"
                               VerticalOptions="Center"
                               Margin="0,0,14,0"
                               Grid.Column="2"/>
                    </Grid>
                </Border>

                <!-- Card Evento 4 -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#161B27}"
                        Stroke="{AppThemeBinding Light=#E8EAF0, Dark=#252B3B}"
                        StrokeThickness="1"
                        Padding="0"
                        MinimumHeightRequest="64">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="4,*,Auto">
                        <BoxView BackgroundColor="{AppThemeBinding Light=#9C36B5, Dark=#72288A}"
                                 Grid.Column="0"/>
                        <Button x:Name="BtnEventoRecente4"
                                Text="Evento 4"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light=#22223B, Dark=#E0E0F0}"
                                FontSize="15"
                                FontAttributes="Bold"
                                Grid.Column="1"/>
                        <Label Text="›"
                               FontSize="22"
                               TextColor="{AppThemeBinding Light=#BBBBCC, Dark=#444466}"
                               VerticalOptions="Center"
                               Margin="0,0,14,0"
                               Grid.Column="2"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>